  <animation>
    <type>rotate</type>
    <object-name>key</object-name>
    <property>controls/engines/engine/ignition</property>
       <interpolation>
	  <entry>
        <ind>0</ind>
        <dep>0</dep>
      </entry>
      <entry>
        <ind>1</ind>
        <dep>40</dep>
      </entry>
      <entry>
        <ind>2</ind>
        <dep>70</dep>
      </entry>
      <entry>
        <ind>3</ind>
        <dep>120</dep>
      </entry>
    </interpolation>
    <center>
      <x-m>0.0</x-m>
      <y-m>-0.063</y-m>
      <z-m>0.244</z-m>
    </center>
    <axis>
      <x>-1.0</x>
      <y>0.0</y>
      <z>0.0</z>
