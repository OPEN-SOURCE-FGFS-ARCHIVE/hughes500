<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>tailrpm.ac</path>

 <!--<animation>
    <object-name>fond</object-name>
    <object-name>face</object-name>
    <object-name>needle1</object-name>
    <object-name>needle2</object-name>

  
  </animation>
-->
  
  


  <animation>
    <type>material</type>
    <object-name>face</object-name>
    <object-name>needle1</object-name>
    <object-name>needle2</object-name>
     <condition>
      <property>/controls/lighting/instrument-lights</property>
    </condition>
    <emission>
      <red>   0.80 </red>
      <green> 0.50 </green>
      <blue>  0.50 </blue>
    </emission>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>needle1</object-name>
    <property>sim/model/bo105/torque-pct</property>
    <interpolation>
      <entry><ind>   0 </ind><dep> -260 </dep></entry>
      <entry><ind> 162 </ind><dep> -105 </dep></entry>
      <entry><ind> 324 </ind><dep>   40 </dep></entry>
    </interpolation>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>needle2</object-name>
    <property>rotors/tail/rpm</property>
    <interpolation>
      <entry><ind>   0 </ind><dep> -260 </dep></entry>
      <entry><ind> 220 </ind><dep>    8 </dep></entry>
      <entry><ind> 400 </ind><dep>   70 </dep></entry>
    </interpolation>
    <center>
      <x-m>  0.001 </x-m>
      <y-m> -0.008 </y-m>
      <z-m>  0.009 </z-m>
    </center>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

</PropertyList>

