<!--== rotors ==-->

	<!-- tail rotor blades -->
	
	 <effect>
        <inherits-from>Effects/model-transparent</inherits-from>
        <condition>
            <property>sim/rendering/rembrandt/enabled</property>
        </condition>
		
       <object-name>tailrotor</object-name>
    <object-name>blurred</object-name>
    </effect> 
	
	
	  <animation>
	<type>material</type>
	  <object-name>tailrotor</object-name>
		<global type="bool">true</global>
		<transparency>
			<alpha-prop>rotors/main/rpm</alpha-prop>
			<factor>-0.0045</factor>
			<offset>1</offset>
			<max>1</max>
		</transparency>
    </animation>
	
	 <animation>
        <type>select</type>
       <object-name>tailrotor</object-name>
        <condition>
            <less-than>
                <property>rotors/main/rpm</property>
                <value>201</value>
            </less-than>
        </condition>
    </animation>
	
	 <animation>
        <type>select</type>
      <object-name>blurred</object-name>
        <condition>
            <greater-than>
                <property>rotors/main/rpm</property>
                <value>200.999</value>
            </greater-than>
        </condition>
    </animation>
	
	
 
<!-- ALS effects-->
	<effect>
		<inherits-from>Aircraft/hughes500/Models/Effects/glassout</inherits-from>
		<object-name>l-door-glass</object-name>
<object-name>r-door-glass</object-name>
		<object-name>glass</object-name>
	</effect> 
	
	 <effect>
        <inherits-from>Effects/glass</inherits-from>
        <object-name>l-door-glassin</object-name>
<object-name>r-door-glassin</object-name>
		<object-name>glassin</object-name>
    </effect>
	
	<animation>
  <type>select</type>
 <object-name>l-door-glass</object-name>
<object-name>r-door-glass</object-name>
		<object-name>glass</object-name>	
  <condition>
   <not>
   <equals>
    <property>sim/current-view/internal</property>
    <value>true</value>
   </equals>
   </not>
  </condition>
 </animation>
 
  <animation>
  <type>select</type>
  <object-name>l-door-glassin</object-name>
<object-name>r-door-glassin</object-name>
		<object-name>glassin</object-name>
  <condition>

   <equals>
    <property>sim/current-view/internal</property>
    <value>true</value>
   </equals>
   
  </condition>
 </animation>

	
	<!-- Solid Surfaces for Rembrandt rendering -->
   <animation>
    
  	<object-name>skids</object-name>
		<object-name>fuselage</object-name>
		<object-name>tail</object-name>
		<object-name>mainrotor</object-name>
		<object-name>POLY.051</object-name>
		<object-name>tailrotor</object-name>
		
    </animation>	


	
	
