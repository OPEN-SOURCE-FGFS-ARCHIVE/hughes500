		<starter>
			<name>starter0_start</name>
			<mode>once</mode>
			<path>Aircraft/hughes500/Sounds/startup_exterior.wav</path>
			<condition>
				<property>controls/engines/engine[0]/starter</property>
			</condition>
			<volume>
				<factor>1</factor>
			</volume>
			<position>
				<x>-0.88</x>
				<y>0.40</y>
				<z>0.5</z>
			</position>
			<reference-dist>5</reference-dist>
			<max-dist>1000</max-dist>
		</starter>

		<starter>
			<name>starter0_start_interior</name>
			<mode>once</mode>
			<path>Aircraft/hughes500/Sounds/startup_interior_mono.wav</path>
			
			<condition>
			<and>
			<property>sim/current-view/internal</property>
				<property>controls/engines/engine[0]/starter</property>
				</and>
			</condition>
			<volume>
				<factor>0.7</factor>
			</volume>	
			<position>
				<x>-0.88</x>
				<y>0.40</y>
				<z>0.5</z>
			</position>
			<reference-dist>3</reference-dist>
			<max-dist>10</max-dist>
		</starter>





		<starter>
			<name>starter0_loop</name>
			<mode>looped</mode>
			<path>Aircraft/hughes500/Sounds/starter_loop.wav</path>
			<condition>
			<and>
			<property>sim/current-view/internal</property>
				<property>controls/engines/engine[0]/starter</property>
				</and>
			</condition>
			<delay-sec>11.6</delay-sec>
			<volume>
				<factor>0.3</factor>
			</volume>
			<position>
				<x>-0.88</x>
				<y>0.40</y>
				<z>0.5</z>
			</position>
			<reference-dist>5</reference-dist>
			<max-dist>10</max-dist>
		</starter>

		<starter>
			<name>starter0_stop</name>
			<mode>once</mode>
			<path>Aircraft/hughes500/Sounds/starter_stop.wav</path>
			<condition>
			<and>
			<property>sim/current-view/internal</property>
				<not>
					<property>controls/engines/engine[0]/starter</property>
				</not>
				</and>
			</condition>
			<volume>
				<factor>0.3</factor>
			</volume>
			<position>
				<x>-0.88</x>
				<y>0.40</y>
				<z>0.5</z>
			</position>
			<reference-dist>5</reference-dist>
			<max-dist>10</max-dist>
		</starter>



		<rotor>
			<name>rotor-outside</name>
			<mode>looped</mode>
			<path>Aircraft/hughes500/Sounds/flight_exterior.wav</path>
			<condition>
				<and>
					<not>
						<property>sim/current-view/internal</property>
					</not>
					<greater-than>
						<property>rotors/main/rpm</property>
						<value>25</value>
					</greater-than>
					<not>
						<property>sim/crashed</property>
					</not>
				</and>
			</condition>
			<volume>
				<property>rotors/main/rpm</property>
				<factor>0.002</factor>
			</volume>
			<pitch>
				<property>rotors/main/rpm</property>
				<factor>0.0023</factor>
				<offset>0</offset>
				<min>1.0</min>
				<max>1.2</max>
			</pitch>
			<reference-dist>5</reference-dist>
			<max-dist>2000</max-dist>
		</rotor>

